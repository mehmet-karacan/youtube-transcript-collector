{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/youtube-transcript-collector/collection-request.schema.json",
  "type": "object",
  "required": ["scope", "targets", "languages", "selector", "include_completed_live", "rate_policy"],
  "properties": {
    "scope": {"enum": ["single_video", "video_list", "channel_all", "channel_selection"]},
    "targets": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"type": "string", "maxLength": 2048}},
    "languages": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?![Aa][Ll][Ll]$)[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$"}},
    "selector": {
      "type": "object",
      "required": ["latest", "title_query", "date_from", "date_to"],
      "properties": {
        "latest": {"type": ["integer", "null"], "minimum": 1, "maximum": 10000},
        "title_query": {"type": ["string", "null"], "pattern": ".*\\S.*", "maxLength": 200},
        "date_from": {"type": ["string", "null"], "format": "date"},
        "date_to": {"type": ["string", "null"], "format": "date"}
      },
      "additionalProperties": false
    },
    "include_completed_live": {"type": "boolean"},
    "rate_policy": {
      "type": "object",
      "required": ["min_delay_seconds", "max_retries", "rate_limit_cooldown_seconds"],
      "properties": {
        "min_delay_seconds": {"type": "number", "minimum": 0.5, "maximum": 60},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 20},
        "rate_limit_cooldown_seconds": {"type": "integer", "minimum": 60, "maximum": 86400}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "single_video"}}},
      "then": {
        "properties": {
          "targets": {"minItems": 1, "maxItems": 1, "items": {"pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"}},
          "selector": {"properties": {"latest": {"type": "null"}, "title_query": {"type": "null"}, "date_from": {"type": "null"}, "date_to": {"type": "null"}}}
        }
      }
    },
    {
      "if": {"properties": {"scope": {"const": "video_list"}}},
      "then": {
        "properties": {
          "targets": {"minItems": 2, "maxItems": 500, "items": {"pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"}},
          "selector": {"properties": {"latest": {"type": "null"}, "title_query": {"type": "null"}, "date_from": {"type": "null"}, "date_to": {"type": "null"}}}
        }
      }
    },
    {
      "if": {"properties": {"scope": {"enum": ["channel_all", "channel_selection"]}}},
      "then": {"properties": {"targets": {"minItems": 1, "maxItems": 1, "items": {"pattern": "^https://www\\.youtube\\.com/(?:@[A-Za-z0-9._-]{3,30}|(?:channel|c|user)/[A-Za-z0-9._-]+)$"}}}}
    },
    {
      "if": {"properties": {"scope": {"const": "channel_all"}}},
      "then": {"properties": {"selector": {"properties": {"latest": {"type": "null"}, "title_query": {"type": "null"}, "date_from": {"type": "null"}, "date_to": {"type": "null"}}}}}
    },
    {
      "if": {"properties": {"scope": {"const": "channel_selection"}}},
      "then": {"properties": {"selector": {"anyOf": [
        {"properties": {"latest": {"type": "integer"}}},
        {"properties": {"title_query": {"type": "string", "pattern": ".*\\S.*"}}},
        {"properties": {"date_from": {"type": "string"}}},
        {"properties": {"date_to": {"type": "string"}}}
      ]}}}
    }
  ],
  "additionalProperties": false
}
